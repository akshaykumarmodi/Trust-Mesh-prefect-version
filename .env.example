# TrustMesh Environment Configuration

# Database
DATABASE_URL=sqlite:///./trustmesh.db

# AI Engine Configuration
AI_ENABLED=true
AI_PROVIDER=groq
AI_MODEL_NAME=openai/gpt-oss-120b
AI_API_BASE_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=
AI_TEMPERATURE=0.2
AI_MAX_TOKENS=2048

# Automatic User Login Email Notifications (Gmail SMTP + Nodemailer)
# Configure these variables in .env (or Vercel project settings) to receive email notifications
GMAIL_USER=your_sender_account@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
ADMIN_EMAIL=your_admin_email@gmail.com

# SMTP Server details
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true

# Security Secrets
ADMIN_SECRET_KEY=trustmesh_admin_secret_key_2026
JWT_SECRET=trustmesh_jwt_secret_key_2026
