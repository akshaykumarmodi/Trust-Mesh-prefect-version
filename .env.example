# TrustMesh Environment Configuration

# Database
DATABASE_URL=sqlite:///./trustmesh.db

# Open-Weight AI Model (GPT-OSS-120B)
# Note: TrustMesh uses a deterministic fallback engine when this key is omitted.
OPENROUTER_API_KEY=
AI_MODEL_NAME=gpt-oss-120b
AI_API_BASE_URL=https://openrouter.ai/api/v1

# Environment
ENVIRONMENT=development
PORT=8000
