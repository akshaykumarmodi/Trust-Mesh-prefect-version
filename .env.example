# TrustMesh Environment Configuration

# Database
DATABASE_URL=sqlite:///./trustmesh.db

# Open-Weight AI Model (GPT-OSS-120B)
# Note: TrustMesh uses a deterministic fallback engine when this key is omitted.
OPENROUTER_API_KEY=
AI_MODEL_NAME=gpt-oss-120b
AI_API_BASE_URL=https://openrouter.ai/api/v1

# Environment
ENVIRONMENT=development
PORT=8000

# GitHub Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_WEBHOOK_SECRET=
GITHUB_TOKEN=

# Admin Activity Monitoring & Resend Email Service
ADMIN_NOTIFICATION_EMAIL=akshay123modi@gmail.com
RESEND_API_KEY=
# Use Resend's test sender (onboarding@resend.dev) unless you have verified your custom domain in Resend
EMAIL_FROM=TrustMesh Alerts <onboarding@resend.dev>
ADMIN_SECRET_KEY=trustmesh_admin_secret_key_2026
JWT_SECRET=trustmesh_jwt_secret_key_2026
